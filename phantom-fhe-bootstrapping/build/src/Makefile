	cd /home/sandia/codex/phantom-fhe-bootstrapping/build && $(MAKE) $(MAKESILENT) -f src/CMakeFiles/Phantom.dir/build.make src/CMakeFiles/Phantom.dir/util.cu.s
.PHONY : util.cu.s

